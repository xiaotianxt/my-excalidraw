{
  "name": "my-excalidraw",
  "productName": "My Excalidraw",
  "description": "A local-first Excalidraw desktop workspace with recoverable drafts",
  "main": "dist-electron/main.js",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "author": {
    "name": "xiaotianxt",
    "email": "me@xiaotian.dev"
  },
  "license": "MIT",
  "homepage": "https://github.com/xiaotianxt/my-excalidraw",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaotianxt/my-excalidraw.git"
  },
  "bugs": {
    "url": "https://github.com/xiaotianxt/my-excalidraw/issues"
  },
  "keywords": [
    "excalidraw",
    "drawing",
    "electron",
    "react",
    "typescript",
    "workspace",
    "desktop-app"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.electron.json && vite build",
    "build:dir": "npm run build && electron-builder --dir",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:images": "node scripts/test-image-roundtrip.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "dist:linux": "npm run build && electron-builder --linux --publish=never",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "preview": "electron ."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.19"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.2.2",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  }
}
